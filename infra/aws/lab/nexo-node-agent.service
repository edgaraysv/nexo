[Unit]
Description=NEXO privileged node reconciler (lab)
After=network-online.target nexo.service
Wants=network-online.target
Requires=nexo.service
ConditionPathExists=/var/lib/nexo-node/identity/state.json

[Service]
Type=simple
User=root
Group=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/local/lib/nexo/nexo-agent node-service http://127.0.0.1:3000 /var/lib/nexo-node/identity
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
# The reconciler must publish named network-namespace bind mounts in the host
# mount namespace so transient OpenVPN units can use NetworkNamespacePath=.
# Filesystem/Protect* sandboxing can create auxiliary namespaces depending on
# the systemd version and must not be used on this privileged reconciler.
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
